{
  "name": "koishi-plugin-w-node",
  "description": "WillBot: .node file service",
  "version": "2.0.0",
  "main": "lib/index.js",
  "typings": "lib/index.d.ts",
  "files": [
    "lib",
    "dist"
  ],
  "license": "MIT",
  "keywords": [
    "chatbot",
    "koishi",
    "plugin"
  ],
  "koishi": {
    "service": {
      "implements": [
        "node"
      ],
      "optional": [
        "installer"
      ]
    }
  },
  "peerDependencies": {
    "koishi": "^4.18.10"
  },
  "dependencies": {
    "execa": "9.3.1",
    "get-registry": "^1.2.0",
    "semver": "^7.7.4"
  },
  "scripts": {
    "build": "yarn workspace willbot build w-node",
    "yakumo:before:pub": "yarn build",
    "bump": "yarn workspace willbot bump w-node",
    "pub": "yarn workspace willbot pub w-node",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "test": "npx tsx -r yml-register --test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@koishijs/plugin-mock": "^2.6.6",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^25.6.0",
    "@types/semver": "^7",
    "eslint": "^10.2.0",
    "globals": "^17.4.0",
    "typescript-eslint": "^8.58.1"
  }
}
