{
  "name": "koishi-plugin-w-node",
  "description": "WillBot: .node file service",
  "version": "2.0.2",
  "main": "lib/index.js",
  "typings": "lib/index.d.ts",
  "files": [
    "lib",
    "dist"
  ],
  "license": "MIT",
  "keywords": [
    "chatbot",
    "koishi",
    "plugin"
  ],
  "koishi": {
    "service": {
      "implements": [
        "node"
      ],
      "required": [
        "installer"
      ]
    }
  },
  "peerDependencies": {
    "koishi": "^4.18.10"
  },
  "dependencies": {
    "execa": "9.3.1",
    "get-registry": "^1.2.0",
    "semver": "^7.7.4"
  },
  "scripts": {
    "build": "yarn run -T build w-node",
    "yakumo:before:pub": "yarn build",
    "bump": "yarn run -T bump w-node",
    "pub": "yarn run -T pub w-node",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "test": "tsx -r yml-register --test"
  },
  "devDependencies": {
    "@cordisjs/plugin-http": "^0.6.3",
    "@eslint/js": "^10.0.1",
    "@koishijs/plugin-market": "^2.11.11",
    "@koishijs/plugin-mock": "^2.6.6",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^25.6.0",
    "@types/semver": "^7",
    "eslint": "^10.2.0",
    "globals": "^17.4.0",
    "jiti": "^2.7.0",
    "koishi": "^4.18.10",
    "tsx": "^4.23.1",
    "typescript-eslint": "^8.58.1",
    "yml-register": "^1.2.5"
  }
}
